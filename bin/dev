#!/usr/bin/env bash
# One-shot: ttn on :PORT (cloudpub maps this). Ollama only if PAPER_VISION_OLLAMA_FALLBACK=1.
# Ctrl-C stops ttn (+ Ollama if this script started it). Tunnel: `clo run`.
set -euo pipefail
cd "$(dirname "$0")/.."

# Same env as proxy_on() in ~/.zshrc (no credential echo). Gemini needs it from BY.
if [ -z "${HTTPS_PROXY:-}" ] && [ -z "${HTTP_PROXY:-}" ] && [ -f "$HOME/.zshrc" ]; then
  eval "$(python3 - <<'PY'
from pathlib import Path
import re, shlex
text = Path.home().joinpath(".zshrc").read_text()
url_m = re.search(r'^_PROXY_URL="([^"]+)"', text, re.M)
no_m = re.search(r'^_PROXY_NO="([^"]+)"', text, re.M)
if not url_m:
    raise SystemExit(0)
url = url_m.group(1)
no = no_m.group(1) if no_m else "localhost,127.0.0.1,::1"
for key, value in {
    "HTTP_PROXY": url,
    "HTTPS_PROXY": url,
    "http_proxy": url,
    "https_proxy": url,
    "NO_PROXY": no,
    "no_proxy": no,
    "NODE_USE_ENV_PROXY": "1",
}.items():
    print(f"export {key}={shlex.quote(value)}")
PY
)"
fi

set -a
# shellcheck disable=SC1091
[ -f .env ] && . ./.env
set +a

if [ -n "${HTTPS_PROXY:-}${HTTP_PROXY:-}" ]; then
  echo "[dev] proxy on (Gemini via corporate proxy)"
else
  echo "[dev] proxy off — Gemini from this network may fail"
fi

export PORT="${PORT:-3000}"
export RAILS_MAX_THREADS="${RAILS_MAX_THREADS:-8}"
export OLLAMA_URL="${OLLAMA_URL:-http://127.0.0.1:11434}"
export PAPER_VISION_OLLAMA_FALLBACK="${PAPER_VISION_OLLAMA_FALLBACK:-0}"

if ! command -v bundle >/dev/null; then
  echo "[dev] bundle not in PATH. Open a new shell in this directory (rvm picks 3.2.2) and retry." >&2
  exit 1
fi

ollama_pid=""
started_ollama=0

cleanup() {
  if [ "$started_ollama" = 1 ] && [ -n "$ollama_pid" ]; then
    kill "$ollama_pid" 2>/dev/null || true
    wait "$ollama_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

ollama_up() {
  curl -sf --max-time 1 "${OLLAMA_URL}/api/tags" >/dev/null 2>&1
}

want_ollama=0
case "${PAPER_VISION_OLLAMA_FALLBACK}" in
  1|true|TRUE|yes|YES) want_ollama=1 ;;
esac

if [ "$want_ollama" = 1 ]; then
  if ollama_up; then
    echo "[dev] ollama already running at ${OLLAMA_URL}"
  else
    echo "[dev] starting ollama serve (PAPER_VISION_OLLAMA_FALLBACK=1)"
    ollama serve &
    ollama_pid=$!
    started_ollama=1
    for _ in $(seq 1 40); do
      if ollama_up; then
        break
      fi
      sleep 0.25
    done
    if ! ollama_up; then
      echo "[dev] ollama did not start on ${OLLAMA_URL}" >&2
      exit 1
    fi
  fi
else
  echo "[dev] ollama skipped (set PAPER_VISION_OLLAMA_FALLBACK=1 to enable)"
fi

echo "[dev] ttn http://127.0.0.1:${PORT}  (tunnel: https://maladroitly-social-worm.cloudpub.ru)"
exec bundle exec puma -C config/puma.rb -b "tcp://127.0.0.1:${PORT}"
