TTN_HMAC_SECRET=change-me
# Список slug через запятую. * — любой валидный slug (только для локальной разработки).
TTN_ALLOWED_SLUGS=*
PORT=9292

# Gemini first (required for production-quality invoice OCR).
GEMINI_API_KEY=
# Lite-only chain (separate free-tier RPD buckets). Avoid gemini-*-flash non-lite (~20 RPD)
# and gemini-flash-latest (hangs). For ~600–1000 TTN/day enable billing (Tier 1+).
PAPER_VISION_CLOUD_MODEL=gemini-3.1-flash-lite
PAPER_VISION_GEMINI_FALLBACKS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
PAPER_VISION_GEMINI_BUDGET=180
PAPER_VISION_GEMINI_TIMEOUT=45

# Local VL fallback is OFF by default — it rarely yields a usable draft.
# PAPER_VISION_OLLAMA_FALLBACK=1
OLLAMA_URL=http://127.0.0.1:11434
PAPER_VISION_MODEL=qwen2.5vl:7b
